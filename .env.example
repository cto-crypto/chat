# ========================================
# KeevOS — Required Environment Variables
# ========================================

# PostgreSQL connection string
# Vercel Postgres / Neon: copy the connection string from your dashboard
# Supabase: Settings → Database → Connection string (URI mode, port 5432)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Secret for signing demo session JWTs
# Generate with: openssl rand -hex 32
DEMO_SESSION_SECRET=replace-with-a-32-character-secret

# ========================================
# Optional — leave blank to disable
# ========================================

# Public app metadata
NEXT_PUBLIC_APP_NAME=KeevOS
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# Internal API key for /api/* endpoints
KEEVOS_API_KEY=your-internal-api-key

# Email (Resend)
RESEND_API_KEY=re_your_key
EMAIL_FROM=noreply@yourdomain.com
